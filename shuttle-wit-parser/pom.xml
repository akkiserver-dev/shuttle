<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>jp.akkiserver</groupId>
        <artifactId>shuttle</artifactId>
        <version>6.0.1-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>shuttle-wit-parser</artifactId>

    <name>shuttle-wit-parser</name>
    <description>JNI binding to the Rust wit-parser crate, resolving a WIT file's interfaces and functions into Java objects. Build-time only -- not used at WASM runtime.</description>
    <url>https://github.com/akkiserver-dev/shuttle</url>

    <dependencies>
        <!-- Tool used to locate and load platform specific native library -->
        <dependency>
            <groupId>org.questdb</groupId>
            <artifactId>jar-jni</artifactId>
            <version>1.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Version/extensions/configuration inherited from the parent; this module just
                needs the JNI header-generation compiler arg on top. -->
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-h</arg>
                        <arg>target/headers</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <!-- This binding only runs on the build machine (during `generate-sources`
                    of shuttle-wit-maven-plugin), so it is built for the host platform only.
                    The target and library folder come from the host-* profile the root pom
                    activates for the current OS and CPU. -->
                    <execution>
                        <id>build wit-parser-binding</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>
                                ${project.basedir}/src/main/rust/wit-parser-binding</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                                <argument>--profile</argument>
                                <argument>${cargo.profile}</argument>
                                <argument>--target</argument>
                                <argument>${native.rust.target}</argument>
                                <argument>--target-dir</argument>
                                <argument>${project.build.directory}/rust</argument>
                            </arguments>
                            <environmentVariables>
                                <RUSTUP_TOOLCHAIN>stable</RUSTUP_TOOLCHAIN>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <!-- Copy the library built above into the folder jar-jni looks in for the
                    running platform (JNA naming, e.g. libs/linux-x86-64/). -->
                    <execution>
                        <id>copy wit-parser-binding</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>
                                ${project.build.directory}/classes/jp/akkiserver/shuttle/wit/parser/libs/${native.libdir}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>
                                        ${project.build.directory}/rust/${native.rust.target}/${cargo.profile.folder}</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>*.${native.lib.ext}</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
