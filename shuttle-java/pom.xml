<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>jp.akkiserver</groupId>
        <artifactId>shuttle</artifactId>
        <version>6.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>shuttle-java</artifactId>

    <name>shuttle-java</name>
    <description>Java bindings for Wasmtime via a native Rust bridge.</description>
    <url>https://github.com/akkiserver-dev/shuttle</url>

    <dependencies>
        <!-- Tool used to locate and load platform specific native library -->
        <dependency>
            <groupId>org.questdb</groupId>
            <artifactId>jar-jni</artifactId>
            <version>1.2.0</version>
        </dependency>
        <!-- Logging facade -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- Version/extensions/configuration inherited from the parent; this module just
                needs the JNI header-generation compiler arg on top. -->
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-h</arg>
                        <arg>target/headers</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <executions>





                    <execution>
                        <id>build wasm test valuetest</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>generate-test-resources</phase>
                        <configuration>
                            <executable>cargo</executable>
                            <workingDirectory>${project.basedir}/src/test/rust/valuetest</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                                <argument>--profile</argument>
                                <!-- Always use dev profile for faster build: its just a test -->
                                <argument>dev</argument>
                                <argument>--target</argument>
                                <argument>wasm32-unknown-unknown</argument>
                                <argument>--target-dir</argument>
                                <argument>${project.build.directory}/rust-test/valuetest</argument>
                            </arguments>
                            <environmentVariables>
                                <RUSTUP_TOOLCHAIN>stable</RUSTUP_TOOLCHAIN>
                            </environmentVariables>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- Profiles -->
    <profiles>
        <!-- Build linux x86 64 bit version of wasmtime-binding native rust library, active by
        default -->
        <profile>
            <id>build-linux-x86-64</id>
            <activation>
                <property>
                    <name>build-linux-x86-64</name>
                    <value>true</value>
                </property>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <!-- Only build for all platforms during release -->
                            <execution>
                                <id>build linux x86 64 bit</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>compile</phase>
                                <configuration>
                                    <executable>cross</executable>
                                    <workingDirectory>
                                        ${project.basedir}/src/main/rust/wasmtime-binding</workingDirectory>
                                    <arguments>
                                        <argument>build</argument>
                                        <argument>--profile</argument>
                                        <argument>${cargo.profile}</argument>
                                        <argument>--target</argument>
                                        <argument>x86_64-unknown-linux-gnu</argument>
                                        <argument>--target-dir</argument>
                                        <argument>${project.build.directory}/rust</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <RUSTUP_TOOLCHAIN>stable</RUSTUP_TOOLCHAIN>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>

                            <!-- Copy the libraries build to the libs folder within the classes, in
                            a folder
              matching
          the JNA convention to find the suitable library for a target-->
                            <execution>
                                <id>copy-lib-linux-x86-64</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>
                                        ${project.build.directory}/classes/jp/akkiserver/shuttle/libs/linux-x86-64</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>
                                                ${project.build.directory}/rust/x86_64-unknown-linux-gnu/${cargo.profile.folder}</directory>
                                            <filtering>false</filtering>
                                            <includes>
                                                <include>*.so</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Build linux aarch64 bit version of wasmtime-binding native rust library -->
        <profile>
            <id>build-linux-aarch64</id>
            <activation>
                <property>
                    <name>build-linux-aarch64</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <!-- Only build for all platforms during release -->
                            <execution>
                                <id>build linux ARM64 bit</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>compile</phase>
                                <configuration>
                                    <executable>cross</executable>
                                    <workingDirectory>
                                        ${project.basedir}/src/main/rust/wasmtime-binding</workingDirectory>
                                    <arguments>
                                        <argument>build</argument>
                                        <argument>--profile</argument>
                                        <argument>${cargo.profile}</argument>
                                        <argument>--target</argument>
                                        <argument>aarch64-unknown-linux-gnu</argument>
                                        <argument>--target-dir</argument>
                                        <argument>${project.build.directory}/rust</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <RUSTUP_TOOLCHAIN>stable</RUSTUP_TOOLCHAIN>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-lib-linux-aarch64</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>
                                        ${project.build.directory}/classes/jp/akkiserver/shuttle/libs/linux-aarch64</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>
                                                ${project.build.directory}/rust/aarch64-unknown-linux-gnu/${cargo.profile.folder}</directory>
                                            <filtering>false</filtering>
                                            <includes>
                                                <include>*.so</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>

                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>build-windows-x86_64</id>
            <activation>
                <property>
                    <name>build-windows-x86_64</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>build windows x86 64 bit</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>compile</phase>
                                <configuration>
                                    <executable>cross</executable>
                                    <workingDirectory>${project.basedir}/src/main/rust/wasmtime-binding</workingDirectory>
                                    <arguments>
                                        <argument>build</argument>
                                        <argument>--profile</argument>
                                        <argument>${cargo.profile}</argument>
                                        <argument>--target</argument>
                                        <argument>x86_64-pc-windows-msvc</argument>
                                        <argument>--target-dir</argument>
                                        <argument>${project.build.directory}/rust</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <RUSTUP_TOOLCHAIN>stable</RUSTUP_TOOLCHAIN>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-lib-windows-x86-64</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/classes/jp/akkiserver/shuttle/libs/win32-x86-64</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}/rust/x86_64-pc-windows-msvc/${cargo.profile.folder}</directory>
                                            <filtering>false</filtering>
                                            <includes>
                                                <include>*.dll</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Windows x86_64 built with the local cargo (no Docker/cross needed): mvn -P build-host-windows-x86_64 -->
        <profile>
            <id>build-host-windows-x86_64</id>
            <activation>
                <property>
                    <name>build-host-windows-x86_64</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>build host windows x86 64 bit</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>compile</phase>
                                <configuration>
                                    <executable>cargo</executable>
                                    <workingDirectory>${project.basedir}/src/main/rust/wasmtime-binding</workingDirectory>
                                    <arguments>
                                        <argument>build</argument>
                                        <argument>--profile</argument>
                                        <argument>${cargo.profile}</argument>
                                        <argument>--target</argument>
                                        <argument>x86_64-pc-windows-msvc</argument>
                                        <argument>--target-dir</argument>
                                        <argument>${project.build.directory}/rust</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <RUSTUP_TOOLCHAIN>stable</RUSTUP_TOOLCHAIN>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-lib-host-windows-x86-64</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/classes/jp/akkiserver/shuttle/libs/win32-x86-64</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}/rust/x86_64-pc-windows-msvc/${cargo.profile.folder}</directory>
                                            <filtering>false</filtering>
                                            <includes>
                                                <include>*.dll</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>build-windows-aarch64</id>
            <activation>
                <property>
                    <name>build-windows-aarch64</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.2.0</version>
                        <executions>
                            <execution>
                                <id>build windows aarch64</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <phase>compile</phase>
                                <configuration>
                                    <executable>cross</executable>
                                    <workingDirectory>${project.basedir}/src/main/rust/wasmtime-binding</workingDirectory>
                                    <arguments>
                                        <argument>build</argument>
                                        <argument>--profile</argument>
                                        <argument>${cargo.profile}</argument>
                                        <argument>--target</argument>
                                        <argument>aarch64-pc-windows-msvc</argument>
                                        <argument>--target-dir</argument>
                                        <argument>${project.build.directory}/rust</argument>
                                    </arguments>
                                    <environmentVariables>
                                        <RUSTUP_TOOLCHAIN>stable</RUSTUP_TOOLCHAIN>
                                    </environmentVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-lib-windows-aarch64</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/classes/jp/akkiserver/shuttle/libs/win32-aarch64</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}/rust/aarch64-pc-windows-msvc/${cargo.profile.folder}</directory>
                                            <filtering>false</filtering>
                                            <includes>
                                                <include>*.dll</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>