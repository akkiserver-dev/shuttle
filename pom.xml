<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>jp.akkiserver</groupId>
    <artifactId>shuttle</artifactId>
    <version>6.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>shuttle</name>
    <description>Shuttle: a WebAssembly runtime library for Minecraft computer mods. Java bindings for Wasmtime/Weave via a native Rust bridge, plus WIT tooling.</description>
    <url>https://github.com/akkiserver-dev/shuttle</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>akki</name>
            <organization>akkiserver-dev</organization>
            <organizationUrl>https://github.com/akkiserver-dev</organizationUrl>
            <roles>
                <role>maintainer</role>
            </roles>
        </developer>
        <developer>
            <name>Stefan Richter-Huber</name>
            <email>stefan@richter-huber.de</email>
            <organization>Stefan Richter-Huber</organization>
            <organizationUrl>https://github.com/StefanRichterHuber</organizationUrl>
            <roles>
                <role>original author (wasmtime-java-ng)</role>
            </roles>
        </developer>
    </developers>

    <modules>
        <module>shuttle-java</module>
        <module>shuttle-java-example</module>
        <module>shuttle-wit-parser</module>
        <module>shuttle-wit-maven-plugin</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>

        <log4j.version>2.25.4</log4j.version>

        <!-- Cargo profile for development. Change to 'release' for release builds -->
        <cargo.profile>dev</cargo.profile>
        <cargo.profile.folder>debug</cargo.profile.folder>

        <!-- Spotbugs fail on error set to false-->
        <spotbugs.failOnError>false</spotbugs.failOnError>
    </properties>


    <scm>
        <connection>scm:git:https://github.com/akkiserver-dev/shuttle</connection>
        <developerConnection>scm:git:https://github.com/akkiserver-dev/shuttle</developerConnection>
        <url>https://github.com/akkiserver-dev/shuttle</url>
        <tag>v4.0.1</tag>
    </scm>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.9.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                    <waitUntil>published</waitUntil>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <!-- Update this path if your generator uses a specific subfolder -->
                                <source>${project.build.directory}/generated-sources/wit-components</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Profiles -->
    <profiles>
        <!-- Host platform profiles. Exactly one is activated automatically from the running
        JVM's os.name / os.arch, and sets what the JNI modules need to build their native
        library for that platform with plain `cargo` (no cross, no Docker):
          native.rust.target  Rust target triple
          native.libdir       folder under libs/ that jar-jni loads from (JNA naming)
          native.lib.ext      file extension of the built library -->
        <profile>
            <id>host-linux-x86-64</id>
            <activation>
                <os>
                    <name>linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <native.rust.target>x86_64-unknown-linux-gnu</native.rust.target>
                <native.libdir>linux-x86-64</native.libdir>
                <native.lib.ext>so</native.lib.ext>
            </properties>
        </profile>
        <profile>
            <id>host-linux-aarch64</id>
            <activation>
                <os>
                    <name>linux</name>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <native.rust.target>aarch64-unknown-linux-gnu</native.rust.target>
                <native.libdir>linux-aarch64</native.libdir>
                <native.lib.ext>so</native.lib.ext>
            </properties>
        </profile>
        <profile>
            <id>host-windows-x86-64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <native.rust.target>x86_64-pc-windows-msvc</native.rust.target>
                <native.libdir>win32-x86-64</native.libdir>
                <native.lib.ext>dll</native.lib.ext>
            </properties>
        </profile>
        <profile>
            <id>host-windows-aarch64</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <native.rust.target>aarch64-pc-windows-msvc</native.rust.target>
                <native.libdir>win32-aarch64</native.libdir>
                <native.lib.ext>dll</native.lib.ext>
            </properties>
        </profile>
        <profile>
            <id>host-macos-x86-64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <native.rust.target>x86_64-apple-darwin</native.rust.target>
                <native.libdir>darwin-x86-64</native.libdir>
                <native.lib.ext>dylib</native.lib.ext>
            </properties>
        </profile>
        <profile>
            <id>host-macos-aarch64</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <native.rust.target>aarch64-apple-darwin</native.rust.target>
                <native.libdir>darwin-aarch64</native.libdir>
                <native.lib.ext>dylib</native.lib.ext>
            </properties>
        </profile>

        <!-- Release profile -->
        <profile>
            <id>release</id>
            <activation>
                <property>
                    <name>performRelease</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <cargo.profile>release</cargo.profile>
                <cargo.profile.folder>release</cargo.profile.folder>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>1.5</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-release-plugin</artifactId>
                        <version>3.0.1</version>
                        <configuration>
                            <tagNameFormat>v@{project.version}</tagNameFormat>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>


        <profile>
            <id>spotbugs</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.9.8.2</version>
                        <executions>
                            <execution>
                                <id>check</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <plugins>
                                <plugin>
                                    <groupId>com.h3xstream.findsecbugs</groupId>
                                    <artifactId>findsecbugs-plugin</artifactId>
                                    <version>1.14.0</version>
                                </plugin>
                            </plugins>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>